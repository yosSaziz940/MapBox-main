{
  "compilerOptions": {
    "checkJs": true,
    "noEmit": true,
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "CommonJS",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true
  },
  "include": [
    "lib/**/*.js",
    "components/**/*.js"
  ],
  "exclude": ["node_modules", ".next", "__tests__", "__mocks__", "app"]
}
